+// T32 CRC32{B,H,W} <Rd>, <Rn>, <Rm>. Conditions come from an enclosing IT block, which the
+// Thumb translator applies itself.
+bool TranslatorVisitor::thumb32_CRC32(Reg n, Reg d, Imm<2> sz, Reg m) {
+    return CRC32Variant(*this, Cond::AL, sz, n, d, m, CRCType::ISO);
+}
+
+// T32 CRC32C{B,H,W} <Rd>, <Rn>, <Rm>
+bool TranslatorVisitor::thumb32_CRC32C(Reg n, Reg d, Imm<2> sz, Reg m) {
+    return CRC32Variant(*this, Cond::AL, sz, n, d, m, CRCType::Castagnoli);
+}
