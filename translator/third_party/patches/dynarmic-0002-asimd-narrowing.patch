+bool HighNarrowingOperation(TranslatorVisitor& v, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm, NarrowingOperation op, NarrowingRounding rounding) {
+    if (sz == 0b11) {
+        return v.DecodeError();
+    }
+
+    if (mcl::bit::get_bit<0>(Vn) || mcl::bit::get_bit<0>(Vm)) {
+        return v.UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const size_t doubled_esize = 2 * esize;
+
+    const auto d = ToVector(false, Vd, D);
+    const auto n = ToVector(true, Vn, N);
+    const auto m = ToVector(true, Vm, M);
+
+    const auto reg_n = v.ir.GetVector(n);
+    const auto reg_m = v.ir.GetVector(m);
+    auto wide_result = op == NarrowingOperation::Add ? v.ir.VectorAdd(doubled_esize, reg_n, reg_m)
+                                                     : v.ir.VectorSub(doubled_esize, reg_n, reg_m);
+
+    if (rounding == NarrowingRounding::Round) {
+        const u64 round_value = 1ULL << (esize - 1);
+        const auto round_const = v.ir.VectorBroadcast(doubled_esize, v.I(doubled_esize, round_value));
+        wide_result = v.ir.VectorAdd(doubled_esize, wide_result, round_const);
+    }
+
+    const auto result = v.ir.VectorNarrow(doubled_esize, v.ir.VectorLogicalShiftRight(doubled_esize, wide_result, static_cast<u8>(esize)));
+
+    v.ir.SetVector(d, result);
+    return true;
+}
